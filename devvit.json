{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "golferit",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today's daily challenge",
        "description": "Create today's Golferit daily challenge (if not already posted)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/daily-post"
      },
      {
        "label": "Create a practice post",
        "description": "Create a Golferit practice post on a random hole",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-challenge": {
        "endpoint": "/internal/scheduler/daily-challenge",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "golferit_dev"
  }
}
